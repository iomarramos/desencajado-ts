# Puerto del servidor (opcional)
PORT=3000

# Token para el panel administrador (/admin.html y endpoints /api/admin/*)
ADMIN_TOKEN=un-token-secreto

# Credenciales OAuth de Google (https://console.cloud.google.com/apis/credentials)
# Redirect URI autorizada debe coincidir exactamente con GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Cuántos soles de consumo equivalen a 1 estrella (opcional, default 5)
SOLES_PER_PUNTO=5

# Estrellas necesarias para desbloquear 1 recompensa (opcional, default 50)
REWARD_THRESHOLD=50

# Bono de referidos (opcional; 0 = desactivado)
REFERRAL_BONUS_POINTS=20
REFERRAL_WELCOME_POINTS=10

# Estrellas de regalo el día del cumpleaños del cliente (opcional; 0 = desactivado).
# Se paga una sola vez al año, revisado en cada login (el cliente guarda su
# fecha de nacimiento una vez desde cuenta.html).
BIRTHDAY_BONUS_POINTS=30

# Bloqueo de intentos de código 2FA (opcional)
TOTP_MAX_ATTEMPTS=5
TOTP_LOCKOUT_MINUTES=5

# Niveles de fidelidad: estrellas ganadas de por vida para subir de nivel (opcional)
TIER_SILVER_THRESHOLD=100
TIER_GOLD_THRESHOLD=300

# Ruleta de premios: horas de espera entre giros por usuario (opcional)
SPIN_COOLDOWN_HOURS=24

# Notificaciones push (promociones). Generar con:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@desencajado.pe

# Botón "Agregar a Google Wallet" (tarjeta de fidelidad real).
# Requiere una cuenta de Google Wallet Issuer y una service account con la
# Google Wallet API habilitada. Ruta completa paso a paso (crear la cuenta
# Issuer, el proyecto de Cloud, la service account, y sobre todo el paso
# que más se olvida — autorizar la service account DENTRO de la cuenta
# Issuer) en el README, sección "Ruta completa: cuenta de Google Wallet
# Issuer + service account".
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
# Private key del JSON de la service account, con los saltos de línea como \n
GOOGLE_WALLET_PRIVATE_KEY=
# Origen exacto del sitio (debe estar en el JWT "origins")
GOOGLE_WALLET_ORIGIN=http://localhost:3000
GOOGLE_WALLET_CLASS_SUFFIX=desencajado_loyalty_class

# Aviso de proximidad nativo de Google Wallet (opcional): si se completan
# estas dos, el celular del cliente muestra una notificación en la pantalla
# de bloqueo al pasar cerca del local — lo maneja Google, no este servidor.
# Sin ellas, la tarjeta funciona igual, solo sin ese aviso.
# Para sacar la coordenada exacta: clic derecho sobre el local en Google
# Maps → clic en las coordenadas que aparecen arriba para copiarlas.
GOOGLE_WALLET_LOCATION_LAT=
GOOGLE_WALLET_LOCATION_LNG=
