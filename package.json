{
  "name": "desencajado-suscripcion",
  "version": "1.0.0",
  "description": "Web de pre-registro de DESENCAJADO (Papas y Café, Huaraz) con persistencia en SQLite.",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prestart": "npm run build",
    "start": "node dist/server.js",
    "pretest": "npm run build",
    "test": "node --test dist/test/**/*.test.js",
    "prebackup": "npm run build",
    "backup": "node dist/scripts/backup.js"
  },
  "dependencies": {
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/web-push": "^3.6.4",
    "typescript": "^7.0.2"
  }
}
